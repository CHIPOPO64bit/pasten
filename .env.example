# Port for the local server (optional, defaults to 3000)
PORT=3000

# OPTIONAL: TASE Data Hub (datawise.tase.co.il) credentials.
# Register for a free account at https://datawise.tase.co.il/ to get these.
# When set, the app will additionally pull the official list of TASE-listed
# securities so the company directory covers (almost) every Israeli public company.
# Leave blank to run on the built-in curated directory + free Yahoo Finance data.
TASE_API_KEY=
TASE_API_SECRET=
